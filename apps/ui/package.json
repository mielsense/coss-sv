{
  "name": "@coss-sv/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation and registry site for COSS for Svelte.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "registry:build": "pnpm registry:generate && tsx scripts/registry/build.mts && pnpm registry:check",
    "registry:check": "pnpm registry:test && tsx scripts/registry/check.mts",
    "registry:generate": "tsx scripts/registry/generate.mts",
    "registry:smoke": "tsx scripts/registry/smoke-install.mts",
    "registry:test": "vitest run --config tests/registry/vitest.config.ts",
    "test": "vitest run && pnpm registry:test",
    "test:e2e": "node tests/site/command-menu.browser.mjs"
  },
  "dependencies": {
    "@coss-sv/ui": "workspace:*",
    "@shardsui/svelte": "0.1.0-beta.0"
  },
  "devDependencies": {
    "@coss-sv/typescript-config": "workspace:*",
    "@sveltejs/adapter-vercel": "catalog:dev",
    "@sveltejs/kit": "catalog:dev",
    "@sveltejs/vite-plugin-svelte": "catalog:dev",
    "@tailwindcss/vite": "catalog:dev",
    "@types/node": "catalog:dev",
    "mdsvex": "catalog:dev",
    "playwright": "catalog:dev",
    "shiki": "catalog:dev",
    "shadcn-svelte": "1.5.0",
    "svelte": "catalog:dev",
    "svelte-check": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "unified": "9.2.2",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
