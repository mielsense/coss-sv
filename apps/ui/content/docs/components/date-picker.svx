---
title: Date Picker
description: A date picker component built with Calendar and Popover.
---

<ComponentPreview name="p-date-picker-1" />

## About

The Date Picker is built using a composition of the `Calendar` and `Popover` components.

## Installation

The Date Picker is a composition pattern, not a standalone component. Install the required components:

<InstallCommand
  pnpm="pnpm add @coss-sv/ui @hugeicons/core-free-icons"
  shadcnSvelte="pnpm dlx shadcn-svelte@latest add https://coss-sv.vercel.app/r/calendar.json https://coss-sv.vercel.app/r/popover.json https://coss-sv.vercel.app/r/button.json"
/>

## Usage

```svelte
<script lang="ts">
  import { buttonVariants, Calendar, HugeiconsIcon, Popover } from "@coss-sv/ui";
  import { Calendar03Icon } from "@hugeicons/core-free-icons";

  let date = $state<Date>();
</script>

<Popover.Root>
  <Popover.Trigger class={buttonVariants({ class: "w-[280px] justify-start", variant: "outline" })}>
    <HugeiconsIcon aria-hidden="true" icon={Calendar03Icon} strokeWidth={2} />
    {date ? date.toLocaleDateString() : "Pick a date"}
  </Popover.Trigger>
  <Popover.Popup align="start" class="w-auto p-0">
    <Calendar mode="single" bind:selected={date} />
  </Popover.Popup>
</Popover.Root>
```

