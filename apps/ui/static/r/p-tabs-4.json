{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-tabs-4",
	"type": "registry:block",
	"description": "COSS tabs example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./tabs.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"tabs\"],\n    containerClass: \"**:data-[slot=preview]:w-full sm:**:data-[slot=preview]:max-w-80\",\n    id: \"p-tabs-4\",\n    interactive: true,\n    responsive: true,\n    title: \"Vertical tabs with underline\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Tabs from \"$UI$/tabs/index.js\";\n</script>\n\n<Tabs.Root class=\"w-full flex-row\" defaultValue=\"tab-1\" orientation=\"vertical\">\n  <div class=\"border-s\">\n    <Tabs.List variant=\"underline\">\n      <Tabs.Tab value=\"tab-1\">Tab 1</Tabs.Tab><Tabs.Tab value=\"tab-2\">Tab 2</Tabs.Tab><Tabs.Tab\n        value=\"tab-3\"\n      >\n        Tab 3\n      </Tabs.Tab>\n    </Tabs.List>\n  </div>\n  <Tabs.Panel value=\"tab-1\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 1 content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-2\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 2 content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-3\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 3 content</p>\n  </Tabs.Panel>\n</Tabs.Root>\n",
			"type": "registry:block",
			"target": "p-tabs-4.svelte"
		}
	]
}