{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-table-5",
	"type": "registry:block",
	"description": "COSS table example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./badge.json",
		"./table.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta, type ParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  const particleMeta = {\n    components: [\"badge\", \"table\"],\n    colSpan: 2,\n    containerClass: \"**:data-[slot=preview]:w-full sm:**:data-[slot=preview]:max-w-4xl\",\n    id: \"p-table-5\",\n    interactive: false,\n    responsive: true,\n    title: \"Card-style table\",\n  } satisfies ParticleMeta & { readonly colSpan: 2 };\n  export const meta = defineParticleMeta(particleMeta);\n</script>\n\n<script lang=\"ts\">\n  import { Badge } from \"$COMPONENTS$/ui/badge/index.js\";\n  import * as Table from \"$COMPONENTS$/ui/table/index.js\";\n  const projects = [\n    { project: \"Website Redesign\", status: \"Paid\", team: \"Frontend Team\", budget: \"$12,500\" },\n    { project: \"Mobile App\", status: \"Unpaid\", team: \"Mobile Team\", budget: \"$8,750\" },\n    { project: \"API Integration\", status: \"Pending\", team: \"Backend Team\", budget: \"$5,200\" },\n    { project: \"Database Migration\", status: \"Paid\", team: \"DevOps Team\", budget: \"$3,800\" },\n    { project: \"User Dashboard\", status: \"Paid\", team: \"UX Team\", budget: \"$7,200\" },\n    { project: \"Security Audit\", status: \"Failed\", team: \"Security Team\", budget: \"$2,100\" },\n  ] as const;\n  const statusClass = {\n    Paid: \"bg-emerald-500\",\n    Unpaid: \"bg-muted-foreground/64\",\n    Pending: \"bg-amber-500\",\n    Failed: \"bg-red-500\",\n  } as const;\n</script>\n\n<Table.Root class=\"w-full\" variant=\"card\"\n  ><Table.Header\n    ><Table.Row\n      ><Table.Head>Project</Table.Head><Table.Head>Status</Table.Head><Table.Head>Team</Table.Head\n      ><Table.Head class=\"text-right\">Budget</Table.Head></Table.Row\n    ></Table.Header\n  ><Table.Body\n    >{#each projects as project (project.project)}<Table.Row\n        ><Table.Cell class=\"font-medium\">{project.project}</Table.Cell><Table.Cell\n          ><Badge variant=\"outline\"\n            ><span aria-hidden=\"true\" class={[\"size-1.5 rounded-full\", statusClass[project.status]]}\n            ></span>{project.status}</Badge\n          ></Table.Cell\n        ><Table.Cell>{project.team}</Table.Cell><Table.Cell class=\"text-right\"\n          >{project.budget}</Table.Cell\n        ></Table.Row\n      >{/each}</Table.Body\n  ><Table.Footer\n    ><Table.Row\n      ><Table.Cell colspan={3}>Total Budget</Table.Cell><Table.Cell class=\"text-right\"\n        >$39,550</Table.Cell\n      ></Table.Row\n    ></Table.Footer\n  ></Table.Root\n>\n",
			"type": "registry:block",
			"target": "p-table-5.svelte"
		}
	]
}