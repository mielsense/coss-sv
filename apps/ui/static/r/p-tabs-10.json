{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-tabs-10",
	"type": "registry:block",
	"description": "COSS tabs example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./badge.json",
		"./tabs.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"badge\", \"tabs\"],\n    id: \"p-tabs-10\",\n    interactive: true,\n    responsive: false,\n    title: \"Tabs with count badge\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Badge } from \"$UI$/badge/index.js\";\n  import * as Tabs from \"$UI$/tabs/index.js\";\n</script>\n\n<Tabs.Root defaultValue=\"tab-1\">\n  <Tabs.List>\n    <Tabs.Tab value=\"tab-1\">\n      All\n      <Badge class=\"not-in-data-active:text-muted-foreground\" variant=\"outline\">128</Badge>\n    </Tabs.Tab>\n    <Tabs.Tab value=\"tab-2\">\n      Pending\n      <Badge class=\"not-in-data-active:text-muted-foreground\" variant=\"outline\">8</Badge>\n    </Tabs.Tab>\n    <Tabs.Tab value=\"tab-3\">\n      Completed\n      <Badge class=\"not-in-data-active:text-muted-foreground\" variant=\"outline\">120</Badge>\n    </Tabs.Tab>\n  </Tabs.List>\n  <Tabs.Panel value=\"tab-1\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">All items content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-2\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Pending items content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-3\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Completed items content</p>\n  </Tabs.Panel>\n</Tabs.Root>\n",
			"type": "registry:block",
			"target": "p-tabs-10.svelte"
		}
	]
}