{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-2",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./field.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\nexport const meta = defineParticleMeta({\n  components: [\"field\", \"slider\"],\n  id: \"p-slider-2\",\n  interactive: true,\n  responsive: true,\n  title: \"Slider with label and value\",\n  containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n});\n</script>\n\n<script lang=\"ts\">\nimport * as Field from \"$COMPONENTS$/ui/field/index.js\";\nimport * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n</script>\n<Field.Root class=\"w-full\">\n  <Slider.Root defaultValue={50}>\n    <div class=\"mb-2 flex items-center justify-between gap-1\">\n      <Field.Label class=\"font-medium text-sm\">Opacity</Field.Label>\n      <Slider.Value />\n    </div>\n  </Slider.Root>\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-slider-2.svelte"
		}
	]
}