{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-button-24",
	"type": "registry:block",
	"description": "COSS button example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\"],\n    id: \"p-button-24\",\n    interactive: true,\n    responsive: true,\n    title: \"Social login icon buttons\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import {\n    Facebook01Icon,\n    Github01Icon,\n    GoogleIcon,\n    NewTwitterIcon,\n  } from \"@hugeicons/core-free-icons\";\n\n  const providers = [\n    { icon: GoogleIcon, label: \"Google\" },\n    { icon: Facebook01Icon, label: \"Facebook\" },\n    { icon: NewTwitterIcon, label: \"X\" },\n    { icon: Github01Icon, label: \"GitHub\" },\n  ];\n</script>\n\n<div class=\"inline-flex flex-wrap gap-2\">\n  {#each providers as provider (provider.label)}\n    <Button aria-label={`Login with ${provider.label}`} size=\"icon\" variant=\"outline\">\n      <HugeiconsIcon aria-hidden=\"true\" icon={provider.icon} strokeWidth={2} />\n    </Button>\n  {/each}\n</div>\n",
			"type": "registry:block",
			"target": "p-button-24.svelte"
		}
	]
}