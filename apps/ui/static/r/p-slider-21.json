{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-21",
	"type": "registry:block",
	"description": "COSS slider example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./fieldset.json",
		"./label.json",
		"./number-field.json",
		"./slider.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"fieldset\", \"label\", \"number-field\", \"slider\"],\n    id: \"p-slider-21\",\n    interactive: true,\n    responsive: true,\n    title: \"Object position\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import * as Fieldset from \"$COMPONENTS$/ui/fieldset/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Label } from \"$COMPONENTS$/ui/label/index.js\";\n  import * as NumberField from \"$COMPONENTS$/ui/number-field/index.js\";\n  import * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n  import { RotateLeft01Icon } from \"@hugeicons/core-free-icons\";\n\n  const min = -10;\n  const max = 10;\n  type Axis = \"x\" | \"y\" | \"z\";\n  let values = $state<Record<Axis, number>>({ x: -2, y: 4, z: 2 });\n  function updateValue(axis: Axis, next: number | null) {\n    values = { ...values, [axis]: next ?? 0 };\n  }\n</script>\n\n<Fieldset.Root class=\"flex w-full flex-col gap-4\">\n  <Fieldset.Legend>Object position</Fieldset.Legend>\n  <div class=\"flex flex-col gap-2\">\n    {#each [\"x\", \"y\", \"z\"] as axis (axis)}\n      <div class=\"flex items-center gap-2\">\n        <Label class=\"w-3 text-muted-foreground text-xs\">{axis.toUpperCase()}</Label>\n        <Slider.Root\n          aria-label={`${axis.toUpperCase()} position`}\n          class=\"flex-1\"\n          {max}\n          {min}\n          onValueChange={(next) =>\n            updateValue(axis as Axis, Array.isArray(next) ? (next[0] ?? 0) : next)}\n          value={values[axis as Axis]}\n        />\n        <NumberField.Root\n          aria-label={`Enter ${axis.toUpperCase()} value`}\n          class=\"w-16\"\n          {max}\n          {min}\n          onValueChange={(next) => updateValue(axis as Axis, next)}\n          size=\"sm\"\n          value={values[axis as Axis]}\n          ><NumberField.Group><NumberField.Input /></NumberField.Group></NumberField.Root\n        >\n      </div>\n    {/each}\n  </div>\n  <Button class=\"w-full\" onclick={() => (values = { x: 0, y: 0, z: 0 })} variant=\"outline\"\n    ><HugeiconsIcon\n      aria-hidden=\"true\"\n      class=\"-ms-1 opacity-60\"\n      icon={RotateLeft01Icon}\n      strokeWidth={2}\n    />Reset</Button\n  >\n</Fieldset.Root>\n",
			"type": "registry:block",
			"target": "p-slider-21.svelte"
		}
	]
}