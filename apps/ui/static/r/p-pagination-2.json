{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-pagination-2",
	"type": "registry:block",
	"description": "COSS pagination example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./pagination.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"pagination\"],\n    containerClass: \"**:data-[slot=preview]:w-full\",\n    id: \"p-pagination-2\",\n    interactive: true,\n    responsive: true,\n    title: \"Previous and next pagination\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$UI$/button/index.js\";\n  import * as Pagination from \"$UI$/pagination/index.js\";\n  let currentPage = $state(1);\n  const totalPages = 10;\n</script>\n\n<Pagination.Root>\n  <Pagination.Content class=\"w-full justify-between gap-2\">\n    <Pagination.Item>\n      {#if currentPage === 1}<button\n          class={buttonVariants({ variant: \"outline\" })}\n          disabled\n          type=\"button\"\n        >\n          Previous\n        </button>{:else}<a\n          class={buttonVariants({ variant: \"outline\" })}\n          href={`#page-${currentPage - 1}`}\n          onclick={() => (currentPage -= 1)}\n        >\n          Previous\n        </a>{/if}\n    </Pagination.Item><Pagination.Item>\n      {#if currentPage === totalPages}<button\n          class={buttonVariants({ variant: \"outline\" })}\n          disabled\n          type=\"button\"\n        >\n          Next\n        </button>{:else}<a\n          class={buttonVariants({ variant: \"outline\" })}\n          href={`#page-${currentPage + 1}`}\n          onclick={() => (currentPage += 1)}\n        >\n          Next\n        </a>{/if}\n    </Pagination.Item>\n  </Pagination.Content>\n</Pagination.Root>\n",
			"type": "registry:block",
			"target": "p-pagination-2.svelte"
		}
	]
}