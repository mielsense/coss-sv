			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"number-field\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-number-field-9\",\n    interactive: true,\n    responsive: false,\n    title: \"Number field with step\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as NumberField from \"$UI$/number-field/index.js\";\n</script>\n\n<div class=\"flex flex-col gap-6\">\n  <NumberField.Root defaultValue={0} step={10}>\n    <NumberField.ScrubArea label=\"Step 10\" />\n    <NumberField.Group>\n      <NumberField.Decrement /><NumberField.Input /><NumberField.Increment />\n    </NumberField.Group>\n  </NumberField.Root><NumberField.Root defaultValue={0} step={0.1}>\n    <NumberField.ScrubArea label=\"Step 0.1\" />\n    <NumberField.Group>\n      <NumberField.Decrement /><NumberField.Input /><NumberField.Increment />\n    </NumberField.Group>\n  </NumberField.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-number-field-9.svelte"
		}
