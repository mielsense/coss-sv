{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-otp-field-10",
	"type": "registry:block",
	"description": "COSS otp-field example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./otp-field.json",
		"./field.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"field\", \"otp-field\"],\n    id: \"p-otp-field-10\",\n    interactive: true,\n    responsive: false,\n    title: \"Masked OTP field\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import * as OTPField from \"$COMPONENTS$/ui/otp-field/index.js\";\n\n  const length = 6;\n</script>\n\n<Field.Root class=\"items-center\">\n  <Field.Label>Access code</Field.Label>\n  <OTPField.Root {length} mask>\n    {#each Array(length) as _, index (index)}\n      <OTPField.Input aria-label={`Character ${index + 1} of ${length}`} />\n    {/each}\n  </OTPField.Root>\n  <Field.Description\n    >Use <code class=\"font-mono text-foreground\">mask</code> to obscure the code on shared screens.</Field.Description\n  >\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-otp-field-10.svelte"
		}
	]
}