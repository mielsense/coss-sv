{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-popover-3",
	"type": "registry:block",
	"description": "COSS popover example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./avatar.json",
		"./button.json",
		"./popover.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"avatar\", \"button\", \"popover\"],\n    id: \"p-popover-3\",\n    interactive: true,\n    responsive: true,\n    title: \"Detached popover handle\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Avatar from \"$COMPONENTS$/ui/avatar/index.js\";\n  import { Button, buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Popover from \"$COMPONENTS$/ui/popover/index.js\";\n  import { Notification01Icon, UserIcon } from \"@hugeicons/core-free-icons\";\n  import type { Snippet } from \"svelte\";\n\n  const popoverHandle = Popover.PopoverCreateHandle<Snippet>();\n</script>\n\n{#snippet notificationsContent()}\n  <Popover.Title class=\"text-base\">Notifications</Popover.Title><Popover.Description>\n    You have no new notifications at this time.\n  </Popover.Description>\n{/snippet}\n{#snippet profileContent()}\n  <div class=\"w-48\">\n    <div class=\"flex items-center gap-3\">\n      <Avatar.Root>\n        <Avatar.Image\n          alt=\"Mark Andersson\"\n          src=\"https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80\"\n        /><Avatar.Fallback>MA</Avatar.Fallback>\n      </Avatar.Root>\n      <div class=\"min-w-0 flex-1\">\n        <h4 class=\"line-clamp-1 font-medium text-sm\">Mark Andersson</h4>\n        <div class=\"flex items-center gap-3 text-muted-foreground text-xs\">Product Designer</div>\n      </div>\n    </div>\n    <Button class=\"mt-3 w-full\" size=\"sm\" variant=\"outline\">Log out</Button>\n  </div>\n{/snippet}\n<div class=\"flex gap-2\">\n  <Popover.Trigger\n    aria-label=\"Notifications\"\n    class={buttonVariants({ size: \"icon\", variant: \"outline\" })}\n    handle={popoverHandle}\n    payload={notificationsContent}\n  >\n    <HugeiconsIcon aria-hidden=\"true\" icon={Notification01Icon} strokeWidth={2} />\n  </Popover.Trigger>\n  <Popover.Trigger\n    aria-label=\"Profile\"\n    class={buttonVariants({ size: \"icon\", variant: \"outline\" })}\n    handle={popoverHandle}\n    payload={profileContent}\n  >\n    <HugeiconsIcon aria-hidden=\"true\" icon={UserIcon} strokeWidth={2} />\n  </Popover.Trigger>\n  <Popover.Root handle={popoverHandle}>\n    {#snippet children({ payload })}\n      <Popover.Popup class=\"min-w-none\">\n        {#if payload}\n          {@render payload()}\n        {/if}\n      </Popover.Popup>\n    {/snippet}\n  </Popover.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-popover-3.svelte"
		}
	]
}