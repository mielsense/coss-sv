{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "input",
	"type": "registry:ui",
	"description": "Collects a single line of user input.",
	"dependencies": [
		"@shardsui/svelte@0.1.0-beta.0"
