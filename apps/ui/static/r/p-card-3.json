{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-3",
	"type": "registry:block",
	"description": "COSS card example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./card.json",
		"./field.json",
		"./form.json",
		"./input.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"card\", \"field\", \"form\", \"input\"],\n    containerClass:\n      \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n    id: \"p-card-3\",\n    interactive: true,\n    responsive: true,\n    title: \"Authentication card with separators\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Card from \"$UI$/card/index.js\";\n  import { Button } from \"$UI$/button/index.js\";\n  import * as Field from \"$UI$/field/index.js\";\n  import { Form } from \"$UI$/form/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Input } from \"$UI$/input/index.js\";\n  import ShieldAlertIcon from \"@hugeicons/core-free-icons/ShieldAlertIcon\";\n</script>\n\n<Card.Root class=\"w-full max-w-xs\">\n  <Card.Header class=\"border-b\">\n    <Card.Title>Login to your account</Card.Title>\n    <Card.Description>Enter email and password to login</Card.Description>\n  </Card.Header>\n  <Card.Panel>\n    <Form class=\"flex w-full flex-col gap-4\">\n      <Field.Root>\n        <Field.Label>Email</Field.Label>\n        <Input placeholder=\"Enter your email\" type=\"email\" />\n      </Field.Root>\n      <Field.Root>\n        <Field.Label>Password</Field.Label>\n        <Input placeholder=\"Enter your password\" type=\"password\" />\n      </Field.Root>\n      <Button class=\"w-full\" type=\"submit\">Login</Button>\n    </Form>\n  </Card.Panel>\n  <Card.Footer class=\"border-t\">\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <HugeiconsIcon\n        aria-hidden=\"true\"\n        class=\"size-3 h-lh shrink-0\"\n        icon={ShieldAlertIcon}\n        strokeWidth={2}\n      />\n      <p>The information you enter is encrypted and stored securely.</p>\n    </div>\n  </Card.Footer>\n</Card.Root>\n",
			"type": "registry:block",
			"target": "p-card-3.svelte"
		}
	]
}