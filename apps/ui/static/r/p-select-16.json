{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-select-16",
	"type": "registry:block",
	"description": "COSS select example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./select.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"select\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-select-16\",\n    interactive: true,\n    responsive: false,\n    title: \"Select with left text label\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Select from \"$UI$/select/index.js\";\n\n  const items = [\n    { label: \"JavaScript\", value: \"javascript\" },\n    { label: \"TypeScript\", value: \"typescript\" },\n    { label: \"Python\", value: \"python\" },\n    { label: \"Go\", value: \"go\" },\n  ];\n  type Item = (typeof items)[number];\n</script>\n\n<Select.Root\n  aria-label=\"Select language\"\n  value={items[0]}\n  itemToStringValue={(item: Item) => item.value}\n>\n  <Select.Trigger>\n    <Select.Value>\n      {#snippet children(item: Item | null)}{#if item}<span>\n            <span class=\"text-muted-foreground\">Language:</span>\n            {item.label}\n          </span>{/if}{/snippet}\n    </Select.Value>\n  </Select.Trigger><Select.Popup alignItemWithTrigger={false}>\n    {#each items as item (item.value)}<Select.Item value={item}>{item.label}</Select.Item>{/each}\n  </Select.Popup>\n</Select.Root>\n",
			"type": "registry:block",
			"target": "p-select-16.svelte"
		}
	]
}