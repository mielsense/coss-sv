{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-textarea-12",
	"type": "registry:block",
	"description": "COSS textarea example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./field.json",
		"./textarea.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"field\", \"textarea\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-textarea-12\",\n    interactive: true,\n    responsive: false,\n    title: \"Textarea field with required indicator\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Field from \"$UI$/field/index.js\";\n  import { Textarea } from \"$UI$/textarea/index.js\";\n</script>\n\n<Field.Root>\n  <Field.Label>\n    Message <span class=\"text-destructive-foreground\">*</span>\n  </Field.Label>\n  <Textarea placeholder=\"Type your message here\" required />\n  <Field.Error>Please fill out this field.</Field.Error>\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-textarea-12.svelte"
		}
	]
}