{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-14",
	"type": "registry:block",
	"description": "COSS slider example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./field.json",
		"./slider.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"field\", \"slider\"],\n    id: \"p-slider-14\",\n    interactive: true,\n    responsive: true,\n    title: \"Slider with step buttons\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n  import { MinusSignIcon, PlusSignIcon } from \"@hugeicons/core-free-icons\";\n\n  const min = 0;\n  const max = 200;\n  const step = 5;\n  let value = $state(100);\n</script>\n\n<Field.Root name=\"credits\">\n  <Field.Label class=\"tabular-nums\">{value} credits/mo</Field.Label>\n  <div class=\"flex items-center gap-2\">\n    <Button\n      aria-label=\"Decrease value\"\n      disabled={value === min}\n      onclick={() => (value = Math.max(min, value - step))}\n      size=\"icon\"\n      variant=\"outline\"\n      ><HugeiconsIcon aria-hidden=\"true\" icon={MinusSignIcon} strokeWidth={2} /></Button\n    >\n    <Slider.Root aria-label=\"Credits slider\" class=\"flex-1\" {max} {min} {step} bind:value />\n    <Button\n      aria-label=\"Increase value\"\n      disabled={value === max}\n      onclick={() => (value = Math.min(max, value + step))}\n      size=\"icon\"\n      variant=\"outline\"\n      ><HugeiconsIcon aria-hidden=\"true\" icon={PlusSignIcon} strokeWidth={2} /></Button\n    >\n  </div>\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-slider-14.svelte"
		}
	]
}