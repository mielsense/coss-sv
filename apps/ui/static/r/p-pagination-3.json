{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-pagination-3",
	"type": "registry:block",
	"description": "COSS pagination example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./pagination.json",
		"./select.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"pagination\", \"select\"],\n    containerClass: \"**:data-[slot=preview]:w-full\",\n    id: \"p-pagination-3\",\n    interactive: true,\n    responsive: true,\n    title: \"Pagination with result range\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Pagination from \"$UI$/pagination/index.js\";\n  import * as Select from \"$UI$/select/index.js\";\n  const totalPages = 10;\n  const totalResults = 100;\n  const resultsPerPage = 10;\n  const ranges = Array.from({ length: totalPages }, (_, index) => ({\n    label: `${index * resultsPerPage + 1}-${Math.min((index + 1) * resultsPerPage, totalResults)}`,\n    value: index + 1,\n  }));\n  let currentPage = $state(1);\n</script>\n\n<div class=\"flex items-center justify-between gap-2\">\n  <div class=\"flex items-center gap-2 whitespace-nowrap\">\n    <p class=\"text-muted-foreground text-sm\">Viewing</p>\n    <Select.Root items={ranges} bind:value={currentPage}>\n      <Select.Trigger aria-label=\"Select result range\" class=\"w-fit min-w-none\" size=\"sm\">\n        <Select.Value />\n      </Select.Trigger><Select.Popup>\n        {#each ranges as range (range.value)}<Select.Item value={range.value}>\n            {range.label}\n          </Select.Item>{/each}\n      </Select.Popup>\n    </Select.Root>\n    <p class=\"text-muted-foreground text-sm\">\n      of <strong class=\"font-medium text-foreground\">{totalResults}</strong>\n      results\n    </p>\n  </div>\n  <Pagination.Root>\n    <Pagination.Content class=\"w-full justify-between gap-2\">\n      <Pagination.Item>\n        <Pagination.Previous\n          class=\"sm:*:[svg]:hidden\"\n          disabled={currentPage === 1}\n          href=\"#previous\"\n          onclick={(event) => {\n            event.preventDefault();\n            if (currentPage > 1) currentPage -= 1;\n          }}\n          size=\"sm\"\n        />\n      </Pagination.Item><Pagination.Item>\n        <Pagination.Next\n          class=\"sm:*:[svg]:hidden\"\n          disabled={currentPage === totalPages}\n          href=\"#next\"\n          onclick={(event) => {\n            event.preventDefault();\n            if (currentPage < totalPages) currentPage += 1;\n          }}\n          size=\"sm\"\n        />\n      </Pagination.Item>\n    </Pagination.Content>\n  </Pagination.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-pagination-3.svelte"
		}
	]
}