{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-input-group-8",
	"type": "registry:block",
	"description": "COSS input-group example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./input-group.json",
		"./tooltip.json",
		"./use-copy-to-clipboard.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"input-group\", \"tooltip\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-input-group-8\",\n    interactive: true,\n    responsive: false,\n    title: \"Input group with icon button\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$UI$/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as InputGroup from \"$UI$/input-group/index.js\";\n  import * as Tooltip from \"$UI$/tooltip/index.js\";\n  import Copy01Icon from \"@hugeicons/core-free-icons/Copy01Icon\";\n  import Tick01Icon from \"@hugeicons/core-free-icons/Tick01Icon\";\n  import { useCopyToClipboard } from \"../hooks/use-copy-to-clipboard.svelte.js\";\n\n  let input: HTMLInputElement | null = $state(null);\n  const clipboard = useCopyToClipboard();\n  function copy() {\n    if (!input) return;\n    clipboard.copyToClipboard(input.value);\n  }\n</script>\n\n<InputGroup.Root>\n  <InputGroup.Input aria-label=\"Url\" bind:ref={input} value=\"https://coss.com\" type=\"text\" />\n  <InputGroup.Addon align=\"inline-end\">\n    <Tooltip.Root>\n      <Tooltip.Trigger\n        aria-label=\"Copy\"\n        class={buttonVariants({ size: \"icon-xs\", variant: \"ghost\" })}\n        onclick={copy}\n      >\n        <HugeiconsIcon\n          aria-hidden=\"true\"\n          icon={clipboard.isCopied ? Tick01Icon : Copy01Icon}\n          strokeWidth={2}\n        />\n      </Tooltip.Trigger>\n      <Tooltip.Popup><p>Copy to clipboard</p></Tooltip.Popup>\n    </Tooltip.Root>\n  </InputGroup.Addon>\n</InputGroup.Root>\n",
			"type": "registry:block",
			"target": "p-input-group-8.svelte"
		}
	]
}