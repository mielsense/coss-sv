{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-input-group-8",
	"type": "registry:block",
	"description": "COSS input-group example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./input-group.json",
		"./tooltip.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"input-group\", \"tooltip\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-input-group-8\",\n    interactive: true,\n    responsive: false,\n    title: \"Input group with icon button\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as InputGroup from \"$COMPONENTS$/ui/input-group/index.js\";\n  import * as Tooltip from \"$COMPONENTS$/ui/tooltip/index.js\";\n  import { Copy01Icon, Tick01Icon } from \"@hugeicons/core-free-icons\";\n\n  let input: HTMLInputElement | null = $state(null);\n  let copied = $state(false);\n  async function copy() {\n    if (!input) return;\n    await navigator.clipboard.writeText(input.value);\n    copied = true;\n    setTimeout(() => (copied = false), 1500);\n  }\n</script>\n\n<InputGroup.Root>\n  <InputGroup.Input aria-label=\"Url\" bind:ref={input} value=\"https://coss.com\" type=\"text\" />\n  <InputGroup.Addon align=\"inline-end\">\n    <Tooltip.Root>\n      <Tooltip.Trigger\n        aria-label=\"Copy\"\n        class={buttonVariants({ size: \"icon-xs\", variant: \"ghost\" })}\n        onclick={copy}\n      >\n        <HugeiconsIcon aria-hidden=\"true\" icon={copied ? Tick01Icon : Copy01Icon} strokeWidth={2} />\n      </Tooltip.Trigger>\n      <Tooltip.Popup><p>Copy to clipboard</p></Tooltip.Popup>\n    </Tooltip.Root>\n  </InputGroup.Addon>\n</InputGroup.Root>\n",
			"type": "registry:block",
			"target": "p-input-group-8.svelte"
		}
	]
}