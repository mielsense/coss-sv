{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-input-18",
	"type": "registry:block",
	"description": "COSS input example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./field.json",
		"./input.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"field\", \"input\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-input-18\",\n    interactive: true,\n    responsive: false,\n    title: \"Input with characters remaining counter\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import { Input } from \"$COMPONENTS$/ui/input/index.js\";\n\n  const maxLength = 14;\n  let value = $state(\"\");\n</script>\n\n<Field.Root>\n  <Input aria-label=\"Code\" {maxLength} bind:value placeholder=\"Enter code\" type=\"text\" />\n  <Field.Description>\n    <span class=\"tabular-nums\">{maxLength - value.length}</span>\n    characters left\n  </Field.Description>\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-input-18.svelte"
		}
	]
}