{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-input-14",
	"type": "registry:block",
	"description": "COSS input example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./input.json",
		"./label.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"input\", \"label\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-input-14\",\n    interactive: true,\n    responsive: false,\n    title: \"Input with optional label\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Input } from \"$UI$/input/index.js\";\n  import { Label } from \"$UI$/label/index.js\";\n\n  const id = $props.id();\n</script>\n\n<div class=\"flex flex-col gap-2\">\n  <div class=\"inline-flex w-full items-center justify-between gap-2\">\n    <Label for={id}>Email</Label>\n    <Label as=\"span\" class=\"font-normal text-muted-foreground\">Optional</Label>\n  </div>\n  <Input {id} placeholder=\"Email\" type=\"email\" />\n</div>\n",
			"type": "registry:block",
			"target": "p-input-14.svelte"
		}
	]
}