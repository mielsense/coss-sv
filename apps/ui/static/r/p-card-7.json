{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-7",
	"type": "registry:block",
	"description": "COSS card example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./card.json",
		"./field.json",
		"./form.json",
		"./input.json",
		"./select.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\nexport const meta = defineParticleMeta({\n  components: [\"button\", \"card\", \"field\", \"form\", \"input\", \"select\"],\n  containerClass:\n    \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n  id: \"p-card-7\",\n  interactive: true,\n  responsive: true,\n  title: \"Framed card with no rounded bottom\",\n});\n</script>\n\n<script lang=\"ts\">\nimport { Button } from \"$COMPONENTS$/ui/button/index.js\";\nimport {\n  Card,\n  CardFrame,\n  CardFrameDescription,\n  CardFrameFooter,\n  CardFrameHeader,\n  CardFrameTitle,\n  CardPanel,\n} from \"$COMPONENTS$/ui/card/index.js\";\nimport * as Field from \"$COMPONENTS$/ui/field/index.js\";\nimport { Form } from \"$COMPONENTS$/ui/form/index.js\";\nimport { Input } from \"$COMPONENTS$/ui/input/index.js\";\nimport * as Select from \"$COMPONENTS$/ui/select/index.js\";\nimport { AlertCircleIcon } from \"@hugeicons/core-free-icons\";\nimport HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n\nconst frameworkOptions = [\n  { label: \"Next.js\", value: \"next\" },\n  { label: \"Vite\", value: \"vite\" },\n  { label: \"Remix\", value: \"remix\" },\n  { label: \"Astro\", value: \"astro\" },\n];\nlet framework = $state(\"next\");\n</script>\n\n<CardFrame class=\"w-full max-w-xs\">\n  <CardFrameHeader>\n    <CardFrameTitle>Create project</CardFrameTitle>\n    <CardFrameDescription>Deploy your new project in one-click.</CardFrameDescription>\n  </CardFrameHeader>\n  <Card class=\"rounded-b-none!\">\n    <CardPanel>\n      <Form class=\"flex w-full flex-col gap-4\">\n        <Field.Root>\n          <Field.Label>Name</Field.Label>\n          <Input placeholder=\"Name of your project\" type=\"text\" />\n        </Field.Root>\n        <Field.Root>\n          <Field.Label>Framework</Field.Label>\n          <Select.Root bind:value={framework} items={frameworkOptions}>\n            <Select.Trigger><Select.Value /></Select.Trigger>\n            <Select.Popup>\n              {#each frameworkOptions as option (option.value)}\n                <Select.Item value={option.value}>{option.label}</Select.Item>\n              {/each}\n            </Select.Popup>\n          </Select.Root>\n        </Field.Root>\n        <Button class=\"w-full\" type=\"submit\">Deploy</Button>\n      </Form>\n    </CardPanel>\n  </Card>\n  <CardFrameFooter>\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <HugeiconsIcon\n        aria-hidden=\"true\"\n        class=\"size-3 h-lh shrink-0\"\n        icon={AlertCircleIcon}\n        strokeWidth={2}\n      />\n      <p>This will take a few seconds to complete.</p>\n    </div>\n  </CardFrameFooter>\n</CardFrame>\n",
			"type": "registry:block",
			"target": "p-card-7.svelte"
		}
	]
}