			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\nexport const meta = defineParticleMeta({\n  components: [\"frame\", \"separator\"],\n  containerClass: \"**:data-[slot=preview]:w-full\",\n  id: \"p-frame-4\",\n  interactive: false,\n  responsive: true,\n  title: \"Frame with multiple stacked panels\",\n});\n</script>\n\n<script lang=\"ts\">\nimport {\n  Frame,\n  FrameDescription,\n  FrameHeader,\n  FramePanel,\n  FrameTitle,\n  Separator,\n} from \"@coss-sv/ui\";\n</script>\n\n<Frame class=\"w-full\">\n  <FrameHeader>\n    <FrameTitle>Section header</FrameTitle>\n    <FrameDescription>Brief description about the section</FrameDescription>\n  </FrameHeader>\n  <FramePanel class=\"p-0\">\n    <div class=\"p-5\">\n      <h2 class=\"font-semibold text-sm\">Stacked panel</h2>\n      <p class=\"text-muted-foreground text-sm\">Section description</p>\n    </div>\n    <Separator />\n    <div class=\"p-5\">\n      <h2 class=\"font-semibold text-sm\">Stacked panel</h2>\n      <p class=\"text-muted-foreground text-sm\">Section description</p>\n    </div>\n  </FramePanel>\n</Frame>\n",
			"type": "registry:block",
			"target": "p-frame-4.svelte"
		}
