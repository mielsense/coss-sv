{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-tabs-9",
	"type": "registry:block",
	"description": "COSS tabs example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./tabs.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"tabs\"],\n    id: \"p-tabs-9\",\n    interactive: true,\n    responsive: false,\n    title: \"Tabs with underline and icon on top\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Tabs from \"$UI$/tabs/index.js\";\n  import BoxIcon from \"@hugeicons/core-free-icons/BoxIcon\";\n  import House01Icon from \"@hugeicons/core-free-icons/House01Icon\";\n  import PanelsTopLeftIcon from \"@hugeicons/core-free-icons/PanelsTopLeftIcon\";\n</script>\n\n<Tabs.Root class=\"items-center\" defaultValue=\"tab-1\">\n  <div class=\"border-b\">\n    <Tabs.List variant=\"underline\">\n      <Tabs.Tab class=\"h-auto! flex-col gap-1.5 py-[calc(--spacing(2)-1px)]\" value=\"tab-1\">\n        <HugeiconsIcon\n          aria-hidden=\"true\"\n          class=\"size-4 opacity-60\"\n          icon={House01Icon}\n          strokeWidth={2}\n        />\n        Overview\n      </Tabs.Tab>\n      <Tabs.Tab class=\"h-auto! flex-col gap-1.5 py-[calc(--spacing(2)-1px)]\" value=\"tab-2\">\n        <HugeiconsIcon\n          aria-hidden=\"true\"\n          class=\"size-4 opacity-60\"\n          icon={PanelsTopLeftIcon}\n          strokeWidth={2}\n        />\n        Projects\n      </Tabs.Tab>\n      <Tabs.Tab class=\"h-auto! flex-col gap-1.5 py-[calc(--spacing(2.5)-1px)]\" value=\"tab-3\">\n        <HugeiconsIcon\n          aria-hidden=\"true\"\n          class=\"size-4 opacity-60\"\n          icon={BoxIcon}\n          strokeWidth={2}\n        />\n        Packages\n      </Tabs.Tab>\n    </Tabs.List>\n  </div>\n  <Tabs.Panel value=\"tab-1\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Overview content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-2\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Projects content</p>\n  </Tabs.Panel>\n  <Tabs.Panel value=\"tab-3\">\n    <p class=\"p-4 text-center text-muted-foreground text-xs\">Packages content</p>\n  </Tabs.Panel>\n</Tabs.Root>\n",
			"type": "registry:block",
			"target": "p-tabs-9.svelte"
		}
	]
}