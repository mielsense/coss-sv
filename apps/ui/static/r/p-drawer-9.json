		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"drawer\"],\n    id: \"p-drawer-9\",\n    iframeHeight: 640,\n    interactive: true,\n    responsive: true,\n    title: \"Drawer snap points\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants, Drawer } from \"@coss-sv/ui\";\n\n  const boxes = Array.from({ length: 48 }, (_, index) => `box-${index}`);\n  let snapPoint = $state<string | number | null>(\"300px\");\n</script>\n\n<Drawer.Root bind:snapPoint position=\"bottom\" snapPoints={[\"300px\", 1]} snapToSequentialPoints>\n  <Drawer.Trigger class={buttonVariants({ variant: \"outline\" })}>With snap points</Drawer.Trigger>\n  <Drawer.Popup showBar>\n    <Drawer.Header>\n      <Drawer.Title>Snap Points</Drawer.Title><Drawer.Description>\n        Drag the drawer to snap between a compact peek and full-height view.\n      </Drawer.Description>\n    </Drawer.Header><Drawer.Panel>\n      <div class=\"flex flex-col gap-2\">\n        {#each boxes as box (box)}\n          <div class=\"h-12 shrink-0 rounded-xl border bg-muted\"></div>\n        {/each}\n      </div>\n    </Drawer.Panel>\n  </Drawer.Popup>\n</Drawer.Root>\n",
			"type": "registry:block",
			"target": "p-drawer-9.svelte"
		}
