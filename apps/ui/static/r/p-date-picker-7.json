{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-date-picker-7",
	"type": "registry:block",
	"description": "COSS date-picker example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./badge.json",
		"./button.json",
		"./calendar.json",
		"./popover.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"badge\", \"button\", \"calendar\", \"popover\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-date-picker-7\",\n    interactive: true,\n    responsive: false,\n    title: \"Multiple date picker\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import Calendar03Icon from \"@hugeicons/core-free-icons/Calendar03Icon\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Badge } from \"$UI$/badge/index.js\";\n  import { buttonVariants } from \"$UI$/button/index.js\";\n  import { Calendar } from \"$UI$/calendar/index.js\";\n  import * as Popover from \"$UI$/popover/index.js\";\n  let dates = $state<Date[] | undefined>();\n  const format = (value: Date) =>\n    new Intl.DateTimeFormat(\"en-US\", { month: \"short\", day: \"numeric\" }).format(value);\n</script>\n\n<Popover.Root>\n  <Popover.Trigger class={buttonVariants({ class: \"w-full justify-start\", variant: \"outline\" })}>\n    <HugeiconsIcon class=\"shrink-0\" icon={Calendar03Icon} aria-hidden=\"true\" strokeWidth={2} />\n    <span class=\"flex flex-wrap gap-1\">\n      {#if dates?.length}{#each dates.slice(0, 3) as selected (selected.toISOString())}<Badge\n            variant=\"secondary\"\n          >\n            {format(selected)}\n          </Badge>{/each}{#if dates.length > 3}<Badge variant=\"secondary\">\n            +{dates.length - 3}\n          </Badge>{/if}{:else}<span>Pick dates</span>{/if}\n    </span>\n  </Popover.Trigger><Popover.Popup>\n    <Calendar mode=\"multiple\" bind:selected={dates} />\n  </Popover.Popup>\n</Popover.Root>\n",
			"type": "registry:block",
			"target": "p-date-picker-7.svelte"
		}
	]
}