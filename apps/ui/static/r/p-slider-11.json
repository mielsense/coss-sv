{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-11",
	"type": "registry:block",
	"description": "COSS slider example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./field.json",
		"./slider.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"field\", \"slider\"],\n    id: \"p-slider-11\",\n    interactive: true,\n    responsive: true,\n    title: \"Volume slider\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n  import { VolumeHighIcon, VolumeMute02Icon } from \"@hugeicons/core-free-icons\";\n\n  let value = $state<number | readonly number[]>(25);\n</script>\n\n<Field.Root class=\"*:grid *:grid-cols-[auto_1fr_auto] *:items-center *:gap-x-2\">\n  <Slider.Root aria-label=\"Volume slider\" bind:value>\n    <div class=\"col-span-3 mb-2 flex items-center justify-between gap-1\">\n      <Field.Label>Volume</Field.Label><Slider.Value />\n    </div>\n    <HugeiconsIcon\n      aria-hidden=\"true\"\n      class=\"size-4 shrink-0 opacity-80\"\n      icon={VolumeMute02Icon}\n      strokeWidth={2}\n    />\n    <HugeiconsIcon\n      aria-hidden=\"true\"\n      class=\"order-1 size-4 shrink-0 opacity-80\"\n      icon={VolumeHighIcon}\n      strokeWidth={2}\n    />\n  </Slider.Root>\n</Field.Root>\n",
			"type": "registry:block",
			"target": "p-slider-11.svelte"
		}
	]
}