{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-20",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"slider\"],\n    id: \"p-slider-20\",\n    interactive: true,\n    responsive: true,\n    title: \"Equalizer\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n\n  const bands = [\n    { label: \"60 Hz\", value: 2 },\n    { label: \"250 Hz\", value: 1 },\n    { label: \"1k\", value: -1 },\n    { label: \"4k\", value: -3 },\n    { label: \"16k\", value: 2 },\n  ];\n</script>\n\n<div class=\"flex h-48 justify-center gap-8\">\n  {#each bands as band (band.label)}\n    <Slider.Root\n      aria-label={band.label}\n      defaultValue={band.value}\n      max={5}\n      min={-5}\n      orientation=\"vertical\"\n    />\n  {/each}\n</div>\n",
			"type": "registry:block",
			"target": "p-slider-20.svelte"
		}
	]
}