{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-popover-1",
	"type": "registry:block",
	"description": "COSS popover example.",
	"dependencies": [
		"@coss-sv/ui",
		"@hugeicons/core-free-icons@4.3.0",
		"@hugeicons/svelte@1.1.5"
	],
	"registryDependencies": [
		"./particle-metadata.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"field\", \"form\", \"popover\", \"textarea\"],\n    id: \"p-popover-1\",\n    interactive: true,\n    responsive: true,\n    title: \"Feedback popover\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button, buttonVariants, Field, Form, Popover, Textarea } from \"@coss-sv/ui\";\n</script>\n\n<Popover.Root>\n  <Popover.Trigger class={buttonVariants({ variant: \"outline\" })}>\n    Open Popover\n  </Popover.Trigger><Popover.Popup class=\"w-80\">\n    <div class=\"mb-4\">\n      <Popover.Title class=\"text-base\">Send us feedback</Popover.Title><Popover.Description>\n        Let us know how we can improve.\n      </Popover.Description>\n    </div>\n    <Form class=\"flex w-full flex-col gap-4\">\n      <Field.Root>\n        <Textarea aria-label=\"Send feedback\" id=\"feedback\" placeholder=\"How can we improve?\" />\n      </Field.Root><Button type=\"submit\">Send feedback</Button>\n    </Form>\n  </Popover.Popup>\n</Popover.Root>\n",
			"type": "registry:block",
			"target": "p-popover-1.svelte"
		}
	]
}