{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-tabs-3",
	"type": "registry:block",
	"description": "COSS tabs example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./tabs.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"tabs\"],\n    containerClass: \"**:data-[slot=preview]:w-full sm:**:data-[slot=preview]:max-w-80\",\n    id: \"p-tabs-3\",\n    interactive: true,\n    responsive: true,\n    title: \"Vertical tabs\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Tabs from \"$COMPONENTS$/ui/tabs/index.js\";\n</script>\n\n<Tabs.Root class=\"w-full\" defaultValue=\"tab-1\" orientation=\"vertical\">\n  <Tabs.List>\n    <Tabs.Tab value=\"tab-1\">Tab 1</Tabs.Tab><Tabs.Tab value=\"tab-2\">Tab 2</Tabs.Tab><Tabs.Tab\n      value=\"tab-3\">Tab 3</Tabs.Tab\n    >\n  </Tabs.List>\n  <Tabs.Panel value=\"tab-1\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 1 content</p></Tabs.Panel\n  >\n  <Tabs.Panel value=\"tab-2\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 2 content</p></Tabs.Panel\n  >\n  <Tabs.Panel value=\"tab-3\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 3 content</p></Tabs.Panel\n  >\n</Tabs.Root>\n",
			"type": "registry:block",
			"target": "p-tabs-3.svelte"
		}
	]
}