{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-select-14",
	"type": "registry:block",
	"description": "COSS select example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./select.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"select\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-select-14\",\n    interactive: true,\n    responsive: false,\n    title: \"Status select with colored dot\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Select from \"$UI$/select/index.js\";\n\n  const items = [\n    { color: \"bg-emerald-500\", label: \"Completed\", value: \"completed\" },\n    { color: \"bg-blue-500\", label: \"In Progress\", value: \"in-progress\" },\n    { color: \"bg-amber-500\", label: \"Pending\", value: \"pending\" },\n    { color: \"bg-gray-500\", label: \"Cancelled\", value: \"cancelled\" },\n    { color: \"bg-red-500\", label: \"Failed\", value: \"failed\" },\n  ];\n  type Item = (typeof items)[number];\n</script>\n\n<Select.Root\n  aria-label=\"Select status\"\n  value={items[0]}\n  itemToStringValue={(item: Item) => item.value}\n>\n  <Select.Trigger>\n    <Select.Value>\n      {#snippet children(item: Item | null)}{#if item}<span class=\"flex items-center gap-2\">\n            <span aria-hidden=\"true\" class={[\"size-2 rounded-full\", item.color]}></span>\n            <span class=\"truncate\">{item.label}</span>\n          </span>{/if}{/snippet}\n    </Select.Value>\n  </Select.Trigger><Select.Popup>\n    {#each items as item (item.value)}<Select.Item value={item}>\n        <span class=\"flex items-center gap-2\">\n          <span aria-hidden=\"true\" class={[\"size-2 rounded-full\", item.color]}></span>\n          <span class=\"truncate\">{item.label}</span>\n        </span>\n      </Select.Item>{/each}\n  </Select.Popup>\n</Select.Root>\n",
			"type": "registry:block",
			"target": "p-select-14.svelte"
		}
	]
}