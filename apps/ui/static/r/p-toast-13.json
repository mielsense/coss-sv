{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-toast-13",
	"type": "registry:block",
	"description": "COSS toast example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./toast.json",
		"./tooltip.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"toast\", \"tooltip\"],\n    id: \"p-toast-13\",\n    interactive: true,\n    responsive: false,\n    title: \"Anchored save error toast\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$UI$/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Toast from \"$UI$/toast/index.js\";\n  import * as Tooltip from \"$UI$/tooltip/index.js\";\n  import FloppyDiskIcon from \"@hugeicons/core-free-icons/FloppyDiskIcon\";\n\n  const toastManager = new Toast.Manager();\n  let button = $state<HTMLButtonElement | null>(null);\n  function save() {\n    if (!button) return;\n    toastManager.add({\n      data: { tooltipStyle: true },\n      id: \"coss-demo-anchored-save-error-toast\",\n      positionerProps: { anchor: button, sideOffset: 6 },\n      timeout: 2000,\n      title: \"Couldn't save draft\",\n      type: \"error\",\n    });\n  }\n</script>\n\n<Toast.AnchoredProvider {toastManager}>\n  <Tooltip.Provider>\n    <Tooltip.Root>\n      <Tooltip.Trigger\n        aria-label=\"Save\"\n        bind:ref={button}\n        class={buttonVariants({ size: \"icon\", variant: \"outline\" })}\n        delay={0}\n        onclick={save}\n        type=\"button\"\n      >\n        <HugeiconsIcon aria-hidden=\"true\" icon={FloppyDiskIcon} strokeWidth={2} />\n      </Tooltip.Trigger><Tooltip.Popup><p>Save</p></Tooltip.Popup>\n    </Tooltip.Root>\n  </Tooltip.Provider>\n</Toast.AnchoredProvider>\n",
			"type": "registry:block",
			"target": "p-toast-13.svelte"
		}
	]
}