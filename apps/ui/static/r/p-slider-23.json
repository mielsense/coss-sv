{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-23",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./field.json",
		"./fieldset.json",
		"./form.json",
		"./slider.json",
		"./demo-delay.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"field\", \"fieldset\", \"form\", \"slider\"],\n    id: \"p-slider-23\",\n    interactive: true,\n    responsive: true,\n    title: \"Slider form\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$UI$/button/index.js\";\n  import * as Field from \"$UI$/field/index.js\";\n  import * as Fieldset from \"$UI$/fieldset/index.js\";\n  import { Form } from \"$UI$/form/index.js\";\n  import * as Slider from \"$UI$/slider/index.js\";\n  import { createDemoDelay } from \"../lib/demo-delay.js\";\n\n  const delay = createDemoDelay();\n  let loading = $state(false);\n  let value = $state<number | readonly number[]>([25, 75]);\n  async function submit(event: SubmitEvent) {\n    event.preventDefault();\n    const formData = new FormData(event.currentTarget as HTMLFormElement);\n    loading = true;\n    if (!(await delay())) return;\n    loading = false;\n    window.alert(`Volume: ${formData.getAll(\"volume\").join(\", \")}`);\n  }\n</script>\n\n<Form class=\"flex w-full flex-col gap-4\" onsubmit={submit}>\n  <Fieldset.Root class=\"flex w-full flex-col items-stretch gap-3\">\n    <Field.Root>\n      <Slider.Root name=\"volume\" bind:value>\n        <div class=\"mb-2 flex items-center justify-between gap-1\">\n          <Fieldset.Legend>Volume</Fieldset.Legend>\n          <Slider.Value />\n        </div>\n      </Slider.Root>\n      <Field.Description>Choose a value between 0 and 100</Field.Description>\n    </Field.Root>\n  </Fieldset.Root>\n  <Button {loading} type=\"submit\">Submit</Button>\n</Form>\n",
			"type": "registry:block",
			"target": "p-slider-23.svelte"
		}
	]
}