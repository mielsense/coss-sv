{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-13",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./number-field.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"number-field\", \"slider\"],\n    id: \"p-slider-13\",\n    interactive: true,\n    responsive: true,\n    title: \"Range slider with inputs\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as NumberField from \"$UI$/number-field/index.js\";\n  import * as Slider from \"$UI$/slider/index.js\";\n\n  const min = 0;\n  const max = 50;\n  let values = $state<number[]>([0, 20]);\n  function updateValue(index: number, next: number | null) {\n    const value = next ?? min;\n    values =\n      index === 0\n        ? [Math.min(value, values[1] ?? max), values[1] ?? max]\n        : [values[0] ?? min, Math.max(value, values[0] ?? min)];\n  }\n</script>\n\n<div class=\"flex items-center gap-2\">\n  <NumberField.Root\n    aria-label=\"Minimum value\"\n    class=\"w-10\"\n    max={values[1]}\n    {min}\n    onValueChange={(next) => updateValue(0, next)}\n    size=\"sm\"\n    value={values[0]}\n  >\n    <NumberField.Group><NumberField.Input /></NumberField.Group>\n  </NumberField.Root>\n  <Slider.Root\n    aria-label=\"Dual range slider\"\n    class=\"flex-1 *:min-w-0!\"\n    {max}\n    {min}\n    bind:value={values}\n  />\n  <NumberField.Root\n    aria-label=\"Maximum value\"\n    class=\"w-10\"\n    {max}\n    min={values[0]}\n    onValueChange={(next) => updateValue(1, next)}\n    size=\"sm\"\n    value={values[1]}\n  >\n    <NumberField.Group><NumberField.Input /></NumberField.Group>\n  </NumberField.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-slider-13.svelte"
		}
	]
}