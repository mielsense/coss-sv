{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-calendar-18",
	"type": "registry:block",
	"description": "COSS calendar example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./calendar.json",
		"./field.json",
		"./input-group.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"calendar\", \"field\", \"input-group\"],\n    id: \"p-calendar-18\",\n    interactive: true,\n    responsive: false,\n    title: \"Calendar time input\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import Clock01Icon from \"@hugeicons/core-free-icons/Clock01Icon\";\n  import { Calendar } from \"$UI$/calendar/index.js\";\n  import * as Field from \"$UI$/field/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as InputGroup from \"$UI$/input-group/index.js\";\n  let date = $state<Date | undefined>(new Date());\n  let month = $state(new Date());\n  let timeValue = $state(\"12:00:00\");\n\n  function selectDate(selected: Date | undefined): void {\n    date = selected;\n    if (selected) month = selected;\n  }\n</script>\n\n<div class=\"flex flex-col gap-2\">\n  <Calendar\n    mode=\"single\"\n    {month}\n    onMonthChange={(value) => (month = value)}\n    selected={date}\n    onSelect={selectDate}\n  /><Field.Root class=\"flex-row items-center gap-3\">\n    <Field.Label class=\"whitespace-nowrap text-xs\">Enter time</Field.Label><InputGroup.Root\n      class=\"grow\"\n    >\n      <InputGroup.Input\n        aria-label=\"Select time\"\n        class=\"*:[input]:[&::-webkit-calendar-picker-indicator]:hidden *:[input]:[&::-webkit-calendar-picker-indicator]:appearance-none\"\n        step=\"1\"\n        type=\"time\"\n        bind:value={timeValue}\n      /><InputGroup.Addon>\n        <HugeiconsIcon icon={Clock01Icon} aria-hidden=\"true\" strokeWidth={2} />\n      </InputGroup.Addon>\n    </InputGroup.Root>\n  </Field.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-calendar-18.svelte"
		}
	]
}