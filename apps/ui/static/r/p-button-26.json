{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-button-26",
	"type": "registry:block",
	"description": "COSS button example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\"],\n    id: \"p-button-26\",\n    interactive: true,\n    responsive: false,\n    title: \"Star button with count\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { StarIcon } from \"@hugeicons/core-free-icons\";\n\n  let starred = $state(false);\n</script>\n\n<Button onclick={() => (starred = !starred)}>\n  <HugeiconsIcon\n    aria-hidden=\"true\"\n    class={starred ? \"fill-yellow-500 text-yellow-500\" : undefined}\n    icon={StarIcon}\n    strokeWidth={2}\n  />\n  <span class=\"flex items-baseline gap-2\">\n    {starred ? \"Starred\" : \"Star\"}\n    <span class=\"text-primary-foreground/60 text-xs\">{starred ? 730 : 729}</span>\n  </span>\n</Button>\n",
			"type": "registry:block",
			"target": "p-button-26.svelte"
		}
	]
}