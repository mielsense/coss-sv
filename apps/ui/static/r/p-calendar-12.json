{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-calendar-12",
	"type": "registry:block",
	"description": "COSS calendar example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./calendar.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"calendar\"],\n    id: \"p-calendar-12\",\n    interactive: true,\n    responsive: false,\n    title: \"Calendar week numbers\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Calendar, type CalendarWeekNumberProps } from \"$UI$/calendar/index.js\";\n  let date = $state<Date | undefined>(new Date());\n</script>\n\n{#snippet weekNumber(props: CalendarWeekNumberProps)}\n  <th {...props}>\n    <span class=\"inline-flex size-(--cell-size) items-center justify-center\">\n      {props.week.weekNumber}\n    </span>\n  </th>\n{/snippet}\n\n<Calendar\n  components={{ WeekNumber: weekNumber }}\n  fixedWeeks\n  mode=\"single\"\n  bind:selected={date}\n  showWeekNumber\n/>\n",
			"type": "registry:block",
			"target": "p-calendar-12.svelte"
		}
	]
}