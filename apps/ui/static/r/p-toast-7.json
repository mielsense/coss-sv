{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-toast-7",
	"type": "registry:block",
	"description": "COSS toast example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./toast.json",
		"./tooltip.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"toast\", \"tooltip\"],\n    id: \"p-toast-7\",\n    interactive: true,\n    responsive: false,\n    title: \"Copy button with anchored toast\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import * as Toast from \"$COMPONENTS$/ui/toast/index.js\";\n  import * as Tooltip from \"$COMPONENTS$/ui/tooltip/index.js\";\n  import { Copy01Icon, Tick01Icon } from \"@hugeicons/core-free-icons\";\n  import { onDestroy } from \"svelte\";\n\n  let button = $state<HTMLButtonElement | null>(null);\n  let copied = $state(false);\n  let resetTimer: ReturnType<typeof setTimeout> | undefined;\n\n  async function copy() {\n    if (!button || !navigator.clipboard?.writeText) return;\n    try {\n      await navigator.clipboard.writeText(\"https://coss.com\");\n    } catch {\n      return;\n    }\n    copied = true;\n    Toast.anchoredToastManager.add({\n      data: { tooltipStyle: true },\n      positionerProps: { anchor: button },\n      timeout: 2000,\n      title: \"Copied!\",\n    });\n    if (resetTimer) clearTimeout(resetTimer);\n    resetTimer = setTimeout(() => (copied = false), 2000);\n  }\n\n  onDestroy(() => {\n    if (resetTimer) clearTimeout(resetTimer);\n  });\n</script>\n\n<Toast.AnchoredProvider\n  ><Tooltip.Provider\n    ><Tooltip.Root\n      ><Tooltip.Trigger\n        aria-label=\"Copy link\"\n        bind:ref={button}\n        class={buttonVariants({ size: \"icon\", variant: \"outline\" })}\n        disabled={copied}\n        onclick={copy}\n        type=\"button\"\n        ><HugeiconsIcon\n          aria-hidden=\"true\"\n          class=\"size-4\"\n          icon={copied ? Tick01Icon : Copy01Icon}\n          strokeWidth={2}\n        /></Tooltip.Trigger\n      ><Tooltip.Popup><p>Copy to clipboard</p></Tooltip.Popup></Tooltip.Root\n    ></Tooltip.Provider\n  ></Toast.AnchoredProvider\n>\n",
			"type": "registry:block",
			"target": "p-toast-7.svelte"
		}
	]
}