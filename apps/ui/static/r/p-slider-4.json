{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-4",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\nexport const meta = defineParticleMeta({\n  components: [\"slider\"],\n  id: \"p-slider-4\",\n  interactive: true,\n  responsive: true,\n  title: \"Storage slider\",\n  containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n});\n</script>\n\n<script lang=\"ts\">\nimport * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n</script>\n<div>\n  <Slider.Root aria-label=\"Storage size in GB\" defaultValue={15} max={35} min={5} />\n  <fieldset\n    aria-label=\"Storage size reference values\"\n    class=\"mt-4 flex min-w-0 w-full items-center justify-between gap-1 border-0 p-0 font-medium text-muted-foreground text-xs\"\n  >\n    <span>5 GB</span><span>20 GB</span><span>35 GB</span>\n  </fieldset>\n</div>\n",
			"type": "registry:block",
			"target": "p-slider-4.svelte"
		}
	]
}