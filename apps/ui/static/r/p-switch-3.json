{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-switch-3",
	"type": "registry:block",
	"description": "COSS switch example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./label.json",
		"./switch.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"label\", \"switch\"],\n    id: \"p-switch-3\",\n    interactive: true,\n    responsive: false,\n    title: \"Switch with description\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Label } from \"$COMPONENTS$/ui/label/index.js\";\n  import { Switch } from \"$COMPONENTS$/ui/switch/index.js\";\n\n  const id = $props.id();\n  const labelId = `${id}-label`;\n</script>\n\n<div class=\"flex items-start gap-2\">\n  <Switch aria-labelledby={labelId} checked {id} />\n  <div class=\"flex flex-col gap-1\">\n    <Label for={id} id={labelId}>Marketing emails</Label>\n    <p class=\"text-muted-foreground text-xs\">\n      By enabling marketing emails, you agree to receive emails.\n    </p>\n  </div>\n</div>\n",
			"type": "registry:block",
			"target": "p-switch-3.svelte"
		}
	]
}