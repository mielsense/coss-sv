{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-drawer-5",
	"type": "registry:block",
	"description": "COSS drawer example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./drawer.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"drawer\"],\n    id: \"p-drawer-5\",\n    interactive: true,\n    responsive: true,\n    title: \"Straight drawer positions\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import * as Drawer from \"$COMPONENTS$/ui/drawer/index.js\";\n\n  const positions = [\n    { label: \"Right\", position: \"right\" },\n    { label: \"Left\", position: \"left\" },\n    { label: \"Top\", position: \"top\" },\n    { label: \"Bottom\", position: \"bottom\" },\n  ] as const;\n</script>\n\n<div class=\"flex flex-wrap gap-2\">\n  {#each positions as item}\n    <Drawer.Root position={item.position}>\n      <Drawer.Trigger class={buttonVariants({ variant: \"outline\" })}>\n        {item.label}\n      </Drawer.Trigger><Drawer.Popup variant=\"straight\">\n        <Drawer.Header>\n          <Drawer.Title>{item.label}</Drawer.Title>\n        </Drawer.Header><Drawer.Panel>\n          <p class=\"text-muted-foreground text-sm\">\n            Content from the {item.position}.\n          </p>\n        </Drawer.Panel>\n      </Drawer.Popup>\n    </Drawer.Root>\n  {/each}\n</div>\n",
			"type": "registry:block",
			"target": "p-drawer-5.svelte"
		}
	]
}