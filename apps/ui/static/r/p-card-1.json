{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-1",
	"type": "registry:block",
	"description": "COSS card example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./card.json",
		"./field.json",
		"./form.json",
		"./input.json",
		"./select.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"card\", \"field\", \"form\", \"input\", \"select\"],\n    containerClass:\n      \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n    id: \"p-card-1\",\n    interactive: true,\n    responsive: true,\n    title: \"A basic card with header and footer\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import {\n    Card,\n    CardDescription,\n    CardFooter,\n    CardHeader,\n    CardPanel,\n    CardTitle,\n  } from \"$COMPONENTS$/ui/card/index.js\";\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import { Form } from \"$COMPONENTS$/ui/form/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Input } from \"$COMPONENTS$/ui/input/index.js\";\n  import * as Select from \"$COMPONENTS$/ui/select/index.js\";\n  import { AlertCircleIcon } from \"@hugeicons/core-free-icons\";\n\n  const frameworkOptions = [\n    { label: \"Next.js\", value: \"next\" },\n    { label: \"Vite\", value: \"vite\" },\n    { label: \"Remix\", value: \"remix\" },\n    { label: \"Astro\", value: \"astro\" },\n  ];\n  let framework = $state(\"next\");\n</script>\n\n<Card class=\"w-full max-w-xs\">\n  <CardHeader>\n    <CardTitle>Create project</CardTitle>\n    <CardDescription>Deploy your new project in one-click.</CardDescription>\n  </CardHeader>\n  <CardPanel>\n    <Form class=\"flex w-full flex-col gap-4\">\n      <Field.Root>\n        <Field.Label>Name</Field.Label>\n        <Input placeholder=\"Name of your project\" type=\"text\" />\n      </Field.Root>\n      <Field.Root>\n        <Field.Label>Framework</Field.Label>\n        <Select.Root bind:value={framework} items={frameworkOptions}>\n          <Select.Trigger><Select.Value /></Select.Trigger>\n          <Select.Popup>\n            {#each frameworkOptions as option (option.value)}\n              <Select.Item value={option.value}>{option.label}</Select.Item>\n            {/each}\n          </Select.Popup>\n        </Select.Root>\n      </Field.Root>\n      <Button class=\"w-full\" type=\"submit\">Deploy</Button>\n    </Form>\n  </CardPanel>\n  <CardFooter>\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <HugeiconsIcon\n        aria-hidden=\"true\"\n        class=\"size-3 h-lh shrink-0\"\n        icon={AlertCircleIcon}\n        strokeWidth={2}\n      />\n      <p>This will take a few seconds to complete.</p>\n    </div>\n  </CardFooter>\n</Card>\n",
			"type": "registry:block",
			"target": "p-card-1.svelte"
		}
	]
}