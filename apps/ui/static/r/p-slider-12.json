{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-12",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./number-field.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\nexport const meta = defineParticleMeta({\n  components: [\"number-field\", \"slider\"],\n  id: \"p-slider-12\",\n  interactive: true,\n  responsive: true,\n  title: \"Slider with input\",\n  containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n});\n</script>\n\n<script lang=\"ts\">\nimport * as NumberField from \"$COMPONENTS$/ui/number-field/index.js\";\nimport * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n\nconst min = 0;\nconst max = 150;\nlet value = $state(25);\n</script>\n\n<div class=\"flex items-center gap-4\">\n  <Slider.Root aria-label=\"Slider with input\" class=\"flex-1\" {max} {min} bind:value />\n  <NumberField.Root aria-label=\"Enter slider value\" class=\"w-12\" {max} {min} size=\"sm\" bind:value>\n    <NumberField.Group><NumberField.Input /></NumberField.Group>\n  </NumberField.Root>\n</div>\n",
			"type": "registry:block",
			"target": "p-slider-12.svelte"
		}
	]
}