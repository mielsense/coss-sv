{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-slider-19",
	"type": "registry:block",
	"description": "COSS slider example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./number-field.json",
		"./slider.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\nexport const meta = defineParticleMeta({\n  components: [\"number-field\", \"slider\"],\n  id: \"p-slider-19\",\n  interactive: true,\n  responsive: true,\n  title: \"Vertical slider with input\",\n});\n</script>\n\n<script lang=\"ts\">\nimport * as NumberField from \"$COMPONENTS$/ui/number-field/index.js\";\nimport * as Slider from \"$COMPONENTS$/ui/slider/index.js\";\n\nconst min = 0;\nconst max = 100;\nlet value = $state(25);\n</script>\n\n<div class=\"flex flex-col items-center justify-center gap-4\">\n  <Slider.Root\n    aria-label=\"Vertical slider with input\"\n    {max}\n    {min}\n    orientation=\"vertical\"\n    bind:value\n  />\n  <NumberField.Root aria-label=\"Enter slider value\" class=\"w-16\" {max} {min} size=\"sm\" bind:value\n    ><NumberField.Group><NumberField.Input /></NumberField.Group></NumberField.Root\n  >\n</div>\n",
			"type": "registry:block",
			"target": "p-slider-19.svelte"
		}
	]
}