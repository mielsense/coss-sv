{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-meter-1",
	"type": "registry:block",
	"description": "COSS meter example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./meter.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"meter\"],\n    id: \"p-meter-1\",\n    interactive: false,\n    responsive: false,\n    title: \"Storage usage meter\",\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Meter from \"$UI$/meter/index.js\";\n</script>\n\n<Meter.Root value={75}>\n  <div class=\"flex items-center justify-between gap-2\">\n    <Meter.Label>Storage usage</Meter.Label><Meter.Value />\n  </div>\n  <Meter.Track><Meter.Indicator /></Meter.Track>\n</Meter.Root>\n",
			"type": "registry:block",
			"target": "p-meter-1.svelte"
		}
	]
}