{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-2",
	"type": "registry:block",
	"description": "COSS card example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./card.json",
		"./field.json",
		"./form.json",
		"./input.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"card\", \"field\", \"form\", \"input\"],\n    containerClass:\n      \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n    id: \"p-card-2\",\n    interactive: true,\n    responsive: true,\n    title: \"Authentication card with actions\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$COMPONENTS$/ui/button/index.js\";\n  import {\n    Card,\n    CardAction,\n    CardHeader,\n    CardPanel,\n    CardTitle,\n  } from \"$COMPONENTS$/ui/card/index.js\";\n  import * as Field from \"$COMPONENTS$/ui/field/index.js\";\n  import { Form } from \"$COMPONENTS$/ui/form/index.js\";\n  import { Input } from \"$COMPONENTS$/ui/input/index.js\";\n</script>\n\n<Card class=\"w-full max-w-xs\">\n  <CardHeader>\n    <CardTitle>Login to your account</CardTitle>\n    <CardAction>\n      <!-- svelte-ignore a11y_invalid_attribute -->\n      <!-- biome-ignore lint/a11y/useValidAnchor: exact upstream example uses a placeholder link. -->\n      <a class=\"text-muted-foreground text-sm leading-4.5 hover:underline\" href=\"#\">Sign up</a>\n    </CardAction>\n  </CardHeader>\n  <CardPanel>\n    <Form class=\"flex w-full flex-col gap-4\">\n      <Field.Root>\n        <Field.Label>Email</Field.Label>\n        <Input placeholder=\"Enter your email\" type=\"email\" />\n      </Field.Root>\n      <Field.Root>\n        <Field.Label>Password</Field.Label>\n        <Input placeholder=\"Enter your password\" type=\"password\" />\n      </Field.Root>\n      <Button class=\"w-full\" type=\"submit\">Login</Button>\n    </Form>\n  </CardPanel>\n</Card>\n",
			"type": "registry:block",
			"target": "p-card-2.svelte"
		}
	]
}