{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-date-picker-9",
	"type": "registry:block",
	"description": "COSS date-picker example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./calendar.json",
		"./popover.json",
		"./button.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"calendar\", \"popover\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-date-picker-9\",\n    interactive: true,\n    responsive: true,\n    title: \"Two-month date range picker\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Calendar03Icon } from \"@hugeicons/core-free-icons\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import { Calendar, type DateRange } from \"$COMPONENTS$/ui/calendar/index.js\";\n  import * as Popover from \"$COMPONENTS$/ui/popover/index.js\";\n  const today = new Date(2026, 7, 28, 12);\n  let date = $state<DateRange | undefined>();\n  const format = (value: Date) =>\n    new Intl.DateTimeFormat(\"en-US\", { month: \"short\", day: \"2-digit\", year: \"numeric\" }).format(\n      value,\n    );\n</script>\n\n<Popover.Root\n  ><Popover.Trigger class={buttonVariants({ class: \"w-full justify-start\", variant: \"outline\" })}\n    ><HugeiconsIcon\n      icon={Calendar03Icon}\n      aria-hidden=\"true\"\n      strokeWidth={2}\n    />{#if date?.from}{format(date.from)}{#if date.to}\n        - {format(date.to)}{/if}{:else}<span>Pick a date range</span>{/if}</Popover.Trigger\n  ><Popover.Popup\n    ><Calendar\n      defaultMonth={date?.from}\n      mode=\"range\"\n      numberOfMonths={2}\n      bind:selected={date}\n      {today}\n    /></Popover.Popup\n  ></Popover.Root\n>\n",
			"type": "registry:block",
			"target": "p-date-picker-9.svelte"
		}
	]
}