{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-group-2",
	"type": "registry:block",
	"description": "COSS group example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./group.json",
		"./input.json",
		"./tooltip.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"group\", \"input\", \"tooltip\"],\n    id: \"p-group-2\",\n    interactive: true,\n    responsive: false,\n    title: \"Group with input\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { buttonVariants } from \"$COMPONENTS$/ui/button/index.js\";\n  import * as Group from \"$COMPONENTS$/ui/group/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Input } from \"$COMPONENTS$/ui/input/index.js\";\n  import * as Tooltip from \"$COMPONENTS$/ui/tooltip/index.js\";\n  import { Copy01Icon, Tick01Icon } from \"@hugeicons/core-free-icons\";\n\n  let input: HTMLInputElement | null = $state(null);\n  let isCopied = $state(false);\n\n  async function copy() {\n    if (!input) return;\n    await navigator.clipboard.writeText(input.value);\n    isCopied = true;\n    setTimeout(() => (isCopied = false), 1500);\n  }\n</script>\n\n<Group.Root aria-label=\"Url input\">\n  <Input aria-label=\"Url\" bind:ref={input} value=\"https://coss.com\" type=\"text\" />\n  <Group.Separator />\n  <Tooltip.Root>\n    <Tooltip.Trigger\n      aria-label=\"Copy\"\n      class={buttonVariants({ size: \"icon\", variant: \"outline\" })}\n      onclick={copy}\n    >\n      <HugeiconsIcon aria-hidden=\"true\" icon={isCopied ? Tick01Icon : Copy01Icon} strokeWidth={2} />\n    </Tooltip.Trigger>\n    <Tooltip.Popup><p>Copy to clipboard</p></Tooltip.Popup>\n  </Tooltip.Root>\n</Group.Root>\n",
			"type": "registry:block",
			"target": "p-group-2.svelte"
		}
	]
}