{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-tabs-1",
	"type": "registry:block",
	"description": "COSS tabs example.",
	"dependencies": [
		"@coss-sv/ui",
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"tabs\"],\n    id: \"p-tabs-1\",\n    interactive: true,\n    responsive: true,\n    title: \"Segmented tabs\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Tabs } from \"@coss-sv/ui\";\n</script>\n\n<Tabs.Root defaultValue=\"tab-1\"\n  ><Tabs.List\n    ><Tabs.Tab value=\"tab-1\">Tab 1</Tabs.Tab><Tabs.Tab value=\"tab-2\">Tab 2</Tabs.Tab><Tabs.Tab\n      value=\"tab-3\">Tab 3</Tabs.Tab\n    ></Tabs.List\n  ><Tabs.Panel value=\"tab-1\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 1 content</p></Tabs.Panel\n  ><Tabs.Panel value=\"tab-2\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 2 content</p></Tabs.Panel\n  ><Tabs.Panel value=\"tab-3\"\n    ><p class=\"p-4 text-center text-muted-foreground text-xs\">Tab 3 content</p></Tabs.Panel\n  ></Tabs.Root\n>\n",
			"type": "registry:block",
			"target": "p-tabs-1.svelte"
		}
	]
}