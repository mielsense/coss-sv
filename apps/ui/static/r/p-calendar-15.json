{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-calendar-15",
	"type": "registry:block",
	"description": "COSS calendar example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./calendar.json",
		"./button.json",
		"./date-format.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"calendar\"],\n    id: \"p-calendar-15\",\n    interactive: true,\n    responsive: false,\n    title: \"Calendar current month control\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$UI$/button/index.js\";\n  import { Calendar } from \"$UI$/calendar/index.js\";\n  import { addCalendarDays } from \"$LIB$/date-format.js\";\n  const today = new Date();\n  const selectedDay = addCalendarDays(today, -28);\n  let month = $state(selectedDay);\n  let date = $state<Date | undefined>(selectedDay);\n</script>\n\n<div class=\"flex flex-col items-start gap-2\">\n  <Calendar\n    mode=\"single\"\n    {month}\n    onMonthChange={(value) => (month = value)}\n    bind:selected={date}\n  /><Button onclick={() => (month = today)} size=\"sm\" variant=\"outline\">Current month</Button>\n</div>\n",
			"type": "registry:block",
			"target": "p-calendar-15.svelte"
		}
	]
}