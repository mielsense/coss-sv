{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-group-22",
	"type": "registry:block",
	"description": "COSS group example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./group.json",
		"./label.json",
		"./number-field.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"group\", \"label\", \"number-field\"],\n    id: \"p-group-22\",\n    interactive: true,\n    responsive: false,\n    title: \"Group with two number inputs for range\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Group from \"$UI$/group/index.js\";\n  import { Label } from \"$UI$/label/index.js\";\n  import * as NumberField from \"$UI$/number-field/index.js\";\n</script>\n\n<div class=\"flex flex-col gap-2\">\n  <Label>Range</Label>\n  <Group.Root aria-label=\"Range input\">\n    <NumberField.Root aria-label=\"Min value\" delegate={numberGroup}>\n      <NumberField.Input class=\"text-left\" placeholder=\"From\" />\n    </NumberField.Root>\n    <Group.Separator />\n    <NumberField.Root aria-label=\"Max value\" delegate={numberGroup}>\n      <NumberField.Input class=\"text-left\" placeholder=\"To\" />\n    </NumberField.Root>\n  </Group.Root>\n</div>\n\n{#snippet numberGroup(props: NumberField.NumberFieldGroupProps)}\n  <NumberField.Group {...props} />\n{/snippet}\n",
			"type": "registry:block",
			"target": "p-group-22.svelte"
		}
	]
}