{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-number-field-5",
	"type": "registry:block",
	"description": "COSS number-field example.",
	"registryDependencies": [
		"./particle-metadata.json",
		"./label.json",
		"./number-field.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n  export const meta = defineParticleMeta({\n    components: [\"label\", \"number-field\"],\n    containerClass: \"**:data-[slot=preview]:w-full **:data-[slot=preview]:max-w-64\",\n    id: \"p-number-field-5\",\n    interactive: true,\n    responsive: false,\n    title: \"Number field with label\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import { Label } from \"$COMPONENTS$/ui/label/index.js\";\n  import * as NumberField from \"$COMPONENTS$/ui/number-field/index.js\";\n\n  const id = $props.id();\n</script>\n\n<div class=\"flex flex-col items-start gap-2\">\n  <Label for={id}>Quantity</Label><NumberField.Root defaultValue={0} {id}\n    ><NumberField.Group\n      ><NumberField.Decrement /><NumberField.Input /><NumberField.Increment /></NumberField.Group\n    ></NumberField.Root\n  >\n</div>\n",
			"type": "registry:block",
			"target": "p-number-field-5.svelte"
		}
	]
