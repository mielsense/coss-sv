{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-4",
	"type": "registry:block",
	"description": "COSS card example.",
	"dependencies": [
		"@hugeicons/core-free-icons@4.3.0"
	],
	"registryDependencies": [
		"./particle-metadata.json",
		"./button.json",
		"./card.json",
		"./field.json",
		"./form.json",
		"./input.json",
		"./select.json",
		"./hugeicons-icon.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\n  import { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\n  export const meta = defineParticleMeta({\n    components: [\"button\", \"card\", \"field\", \"form\", \"input\", \"select\"],\n    containerClass:\n      \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n    id: \"p-card-4\",\n    interactive: true,\n    responsive: true,\n    title: \"Framed card with footer\",\n  });\n</script>\n\n<script lang=\"ts\">\n  import * as Card from \"$UI$/card/index.js\";\n  import { Button } from \"$UI$/button/index.js\";\n  import * as Field from \"$UI$/field/index.js\";\n  import { Form } from \"$UI$/form/index.js\";\n  import HugeiconsIcon from \"$LIB$/hugeicons-icon.svelte\";\n  import { Input } from \"$UI$/input/index.js\";\n  import * as Select from \"$UI$/select/index.js\";\n  import AlertCircleIcon from \"@hugeicons/core-free-icons/AlertCircleIcon\";\n\n  const frameworkOptions = [\n    { label: \"Next.js\", value: \"next\" },\n    { label: \"Vite\", value: \"vite\" },\n    { label: \"Remix\", value: \"remix\" },\n    { label: \"Astro\", value: \"astro\" },\n  ];\n  let framework = $state(\"next\");\n</script>\n\n<Card.Frame class=\"w-full max-w-xs\">\n  <Card.Root>\n    <Card.Header>\n      <Card.Title>Create project</Card.Title>\n      <Card.Description>Deploy your new project in one-click.</Card.Description>\n    </Card.Header>\n    <Card.Panel>\n      <Form class=\"flex w-full flex-col gap-4\">\n        <Field.Root>\n          <Field.Label>Name</Field.Label>\n          <Input placeholder=\"Name of your project\" type=\"text\" />\n        </Field.Root>\n        <Field.Root>\n          <Field.Label>Framework</Field.Label>\n          <Select.Root bind:value={framework} items={frameworkOptions}>\n            <Select.Trigger><Select.Value /></Select.Trigger>\n            <Select.Popup>\n              {#each frameworkOptions as option (option.value)}\n                <Select.Item value={option.value}>{option.label}</Select.Item>\n              {/each}\n            </Select.Popup>\n          </Select.Root>\n        </Field.Root>\n        <Button class=\"w-full\" type=\"submit\">Deploy</Button>\n      </Form>\n    </Card.Panel>\n  </Card.Root>\n  <Card.FrameFooter>\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <HugeiconsIcon\n        aria-hidden=\"true\"\n        class=\"size-3 h-lh shrink-0\"\n        icon={AlertCircleIcon}\n        strokeWidth={2}\n      />\n      <p>This will take a few seconds to complete.</p>\n    </div>\n  </Card.FrameFooter>\n</Card.Frame>\n",
			"type": "registry:block",
			"target": "p-card-4.svelte"
		}
	]
}