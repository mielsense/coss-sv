{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "p-card-4",
	"type": "registry:block",
	"description": "COSS card example.",
	"dependencies": [
		"@coss-sv/ui",
		"@hugeicons/core-free-icons@4.3.0",
		"@hugeicons/svelte@1.1.5"
	],
	"registryDependencies": [
		"./particle-metadata.json"
	],
	"files": [
		{
			"content": "<script module lang=\"ts\">\nimport { defineParticleMeta } from \"$LIB$/registry/particle-metadata.js\";\n\nexport const meta = defineParticleMeta({\n  components: [\"button\", \"card\", \"field\", \"form\", \"input\", \"select\"],\n  containerClass:\n    \"**:data-[slot=preview]:w-full **:data-[slot=preview]:flex **:data-[slot=preview]:justify-center\",\n  id: \"p-card-4\",\n  interactive: true,\n  responsive: true,\n  title: \"Framed card with footer\",\n});\n</script>\n\n<script lang=\"ts\">\nimport {\n  Button,\n  Card,\n  CardDescription,\n  CardFrame,\n  CardFrameFooter,\n  CardHeader,\n  CardPanel,\n  CardTitle,\n  Field,\n  Form,\n  Input,\n  Select,\n} from \"@coss-sv/ui\";\nimport { AlertCircleIcon } from \"@hugeicons/core-free-icons\";\nimport { HugeiconsIcon } from \"@hugeicons/svelte\";\n\nconst frameworkOptions = [\n  { label: \"Next.js\", value: \"next\" },\n  { label: \"Vite\", value: \"vite\" },\n  { label: \"Remix\", value: \"remix\" },\n  { label: \"Astro\", value: \"astro\" },\n];\nlet framework = $state(\"next\");\n</script>\n\n<CardFrame class=\"w-full max-w-xs\">\n  <Card>\n    <CardHeader>\n      <CardTitle>Create project</CardTitle>\n      <CardDescription>Deploy your new project in one-click.</CardDescription>\n    </CardHeader>\n    <CardPanel>\n      <Form class=\"flex w-full flex-col gap-4\">\n        <Field.Root>\n          <Field.Label>Name</Field.Label>\n          <Input placeholder=\"Name of your project\" type=\"text\" />\n        </Field.Root>\n        <Field.Root>\n          <Field.Label>Framework</Field.Label>\n          <Select.Root bind:value={framework} items={frameworkOptions}>\n            <Select.Trigger><Select.Value /></Select.Trigger>\n            <Select.Popup>\n              {#each frameworkOptions as option (option.value)}\n                <Select.Item value={option.value}>{option.label}</Select.Item>\n              {/each}\n            </Select.Popup>\n          </Select.Root>\n        </Field.Root>\n        <Button class=\"w-full\" type=\"submit\">Deploy</Button>\n      </Form>\n    </CardPanel>\n  </Card>\n  <CardFrameFooter>\n    <div class=\"flex gap-1 text-muted-foreground text-xs\">\n      <HugeiconsIcon\n        aria-hidden=\"true\"\n        class=\"size-3 h-lh shrink-0\"\n        icon={AlertCircleIcon}\n        strokeWidth={2}\n      />\n      <p>This will take a few seconds to complete.</p>\n    </div>\n  </CardFrameFooter>\n</CardFrame>\n",
			"type": "registry:block",
			"target": "p-card-4.svelte"
		}
	]
}