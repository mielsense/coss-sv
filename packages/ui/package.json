{
  "name": "@coss-sv/ui",
  "version": "0.0.0",
  "description": "Svelte 5 components adapted from the COSS UI library",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/.gitkeep"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./styles/globals.css": "./dist/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-kit sync && svelte-package -i src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-kit sync && svelte-package -i src --watch",
    "pack:check": "pnpm build && publint --strict && node ./scripts/check-pack.mjs",
    "prepack": "pnpm build",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.56.0"
  },
  "dependencies": {
    "@shardsui/svelte": "0.1.0-beta.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@coss-sv/typescript-config": "workspace:*",
    "@sveltejs/kit": "catalog:dev",
    "@sveltejs/package": "catalog:dev",
    "@sveltejs/vite-plugin-svelte": "catalog:dev",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "catalog:dev",
    "@vitest/browser": "catalog:dev",
    "@vitest/browser-playwright": "catalog:dev",
    "playwright": "catalog:dev",
    "publint": "0.3.23",
    "svelte": "catalog:dev",
    "svelte-check": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vitest-browser-svelte": "2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
