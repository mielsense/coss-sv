{
  "name": "@coss-sv/ui",
  "version": "0.0.0",
  "description": "High-fidelity Svelte 5 components adapted from the COSS UI library.",
  "license": "MIT",
  "author": "Miel",
  "homepage": "https://coss-sv.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mielsense/coss-sv.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mielsense/coss-sv/issues"
  },
  "keywords": [
    "components",
    "coss",
    "shards-ui",
    "svelte",
    "svelte5",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22.18 <25"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "!dist/**/.gitkeep",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*fixture*",
    "!dist/**/__snapshots__/**",
    "!dist/**/*.snap"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js",
      "default": "./dist/components/ui/*/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./lib/segmented-control": {
      "types": "./dist/lib/segmented-control.d.ts",
      "default": "./dist/lib/segmented-control.js"
    },
    "./styles/globals.css": "./dist/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-kit sync && svelte-package -i src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-kit sync && svelte-package -i src --watch",
    "pack:check": "pnpm build && publint --strict && node ./scripts/check-pack.mjs",
    "prepack": "pnpm build",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "vitest run --project ssr && vitest run --project browser"
  },
  "peerDependencies": {
    "svelte": "^5.56.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@shardsui/svelte": "0.1.0-beta.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@coss-sv/typescript-config": "workspace:*",
    "@sveltejs/kit": "catalog:dev",
    "@sveltejs/package": "catalog:dev",
    "@sveltejs/vite-plugin-svelte": "catalog:dev",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "catalog:dev",
    "@vitest/browser": "catalog:dev",
    "@vitest/browser-playwright": "catalog:dev",
    "playwright": "catalog:dev",
    "publint": "0.3.23",
    "svelte": "catalog:dev",
    "svelte-check": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vitest-browser-svelte": "3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
